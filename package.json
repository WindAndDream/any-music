{
  "name": "any-music",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "privacy:setup": "node scripts/setup-privacy.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:privacy:history": "node scripts/check-privacy.mjs history",
    "check:git-flow": "node scripts/check-git-flow.mjs pr",
    "build": "pnpm typecheck && pnpm -r --if-present run build:prod",
    "build:dev": "pnpm typecheck && pnpm -r --if-present run build:dev",
    "build:staging": "pnpm typecheck && pnpm -r --if-present run build:staging",
    "build:userscript": "pnpm --filter @any-music/userscript run build:prod",
    "dev:tauri": "pnpm --filter @any-music/tauri dev",
    "start:tauri": "node scripts/start-tauri.mjs",
    "test:virtual-list": "node scripts/start-virtual-list-test.mjs",
    "setup:userscript": "node scripts/setup-userscript-browser.mjs",
    "build:tauri": "pnpm --filter @any-music/tauri run build:prod",
    "build:tauri:dev": "pnpm --filter @any-music/tauri build:dev",
    "build:tauri:staging": "pnpm --filter @any-music/tauri build:staging",
    "bundle:tauri": "pnpm --filter @any-music/tauri bundle",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:build:android-signed": "node scripts/build-signed-android-release.mjs",
    "release:collect": "node scripts/collect-release.mjs",
    "build:userscript:dev": "pnpm --filter @any-music/userscript run build:dev",
    "build:userscript:staging": "pnpm --filter @any-music/userscript run build:staging",
    "dev": "pnpm --filter @any-music/userscript run dev:dev",
    "dev:staging": "pnpm --filter @any-music/userscript run dev:staging",
    "dev:prod": "pnpm --filter @any-music/userscript run dev:prod",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "node scripts/check-package-boundaries.mjs && node scripts/check-plugin-isolation.mjs && node scripts/check-plugin-vm.mjs && node scripts/check-mobile-boundaries.mjs && oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "node --test scripts/test/*.test.mjs && pnpm -r --workspace-concurrency=1 --if-present run test",
    "test:workbench": "pnpm --filter @any-music/music-workbench test",
    "test:workbench:changed": "pnpm --filter @any-music/music-workbench exec vitest run --changed",
    "typecheck": "pnpm -r --if-present run typecheck",
    "generate:protocol": "node scripts/generate-plugin-protocol.mjs",
    "check:protocol:generated": "node scripts/generate-plugin-protocol.mjs --check",
    "check:protocol": "node scripts/check-plugin-protocol.mjs",
    "check:rust:boundaries": "node scripts/check-rust-workspace.mjs",
    "check:rust:release": "node scripts/check-rust-release.mjs",
    "check:rust:msrv": "cargo +1.90.0 check --workspace --all-targets --locked --target-dir target/msrv",
    "check:rust:deny": "cargo deny --locked check",
    "check:rust:deny:pure": "cargo deny --locked --exclude any-music-tauri --exclude am-plugin-net check",
    "check:native": "pnpm --filter @any-music/tauri check:native",
    "prepare": "husky",
    "accept:plugin:isolation": "pnpm --filter @any-music/tauri build:isolation-probe && cargo build -p any-music-tauri --example plugin-isolation-probe --features s03-isolation-probe --locked && node apps/tauri/scripts/accept-isolation-probe.mjs",
    "check:plugin:isolation": "node scripts/check-plugin-isolation.mjs && pnpm --filter @any-music/tauri exec vitest run test/isolation-probe && cargo check -p any-music-tauri --locked && pnpm --filter @any-music/tauri build:isolation-probe && cargo test -p any-music-tauri --features s03-isolation-probe --lib isolation --locked && cargo check -p any-music-tauri --example plugin-isolation-probe --features s03-isolation-probe --locked",
    "check:plugin:vm": "node scripts/check-plugin-vm.mjs && pnpm --filter @any-music/plugin-vm --filter @any-music/plugin-sandbox-browser --filter @any-music/plugin-testkit test",
    "check:plugin:package": "node scripts/check-plugin-package.mjs && cargo test -p am-plugin-package --locked && cargo test -p any-music-tauri --lib plugins::packages --locked",
    "check:plugin:tools": "node scripts/check-plugin-tools.mjs",
    "check:mobile:boundaries": "node scripts/check-mobile-boundaries.mjs",
    "check:mobile:android": "node scripts/check-mobile-android.mjs",
    "build:mobile:android": "node scripts/build-mobile-android.mjs",
    "build:mobile:ios": "pnpm --filter @any-music/tauri tauri ios build --target aarch64 --export-method app-store-connect -- --locked --no-default-features",
    "check:mobile:release": "node scripts/check-mobile-release.mjs",
    "accept:mobile:android": "node scripts/accept-mobile-android.mjs",
    "accept:mobile:android:device": "node scripts/accept-mobile-android-device.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.23.0"
}
