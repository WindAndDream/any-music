{
  "name": "@any-music/tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --mode dev",
    "build": "pnpm run build:prod",
    "build:dev": "tauri build --no-bundle --debug --config src-tauri/tauri.dev.conf.json -- --locked --no-default-features",
    "build:staging": "tauri build --no-bundle --config src-tauri/tauri.staging.conf.json -- --locked --no-default-features",
    "build:prod": "tauri build --no-bundle -- --locked --no-default-features",
    "build:frontend": "vite build --mode prod",
    "bundle": "tauri build -- --locked --no-default-features",
    "check:rust": "pnpm -w check:protocol:generated && pnpm -w check:rust:boundaries && cargo fmt --manifest-path ../../Cargo.toml --all --check && cargo clippy --manifest-path ../../Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "android:dev": "tauri android dev",
    "ios:dev": "tauri ios dev",
    "test": "vitest run && cargo test --manifest-path ../../Cargo.toml --workspace --locked && pnpm -w check:protocol",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && pnpm check:rust",
    "check:native": "cargo check --manifest-path ../../Cargo.toml --workspace --all-targets --locked && pnpm -w check:rust:release",
    "tauri": "tauri",
    "build:isolation-probe": "node scripts/build-isolation-probe.mjs"
  },
  "dependencies": {
    "@any-music/account-pool": "workspace:*",
    "@any-music/core": "workspace:*",
    "@any-music/music-workbench": "workspace:*",
    "@any-music/network-routing": "workspace:*",
    "@any-music/plugin-center": "workspace:*",
    "@any-music/plugin-music-creation": "workspace:*",
    "@any-music/plugin-sandbox-browser": "workspace:*",
    "@any-music/plugin-sdk": "workspace:*",
    "@any-music/plugin-source-bilibili": "workspace:*",
    "@any-music/plugin-source-douyin": "workspace:*",
    "@any-music/plugin-source-netease": "workspace:*",
    "@any-music/plugin-tag-management": "workspace:*",
    "@any-music/plugin-ui-vue": "workspace:*",
    "@any-music/plugin-vm": "workspace:*",
    "@any-music/theme-default": "workspace:*",
    "@any-music/theme-studio": "workspace:*",
    "@any-music/ui": "workspace:*",
    "@tauri-apps/api": "2.12.1",
    "pinia": "catalog:",
    "qrcode": "1.5.4",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.31.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-vue": "catalog:",
    "quickjs-emscripten-core": "0.31.0",
    "sass": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
