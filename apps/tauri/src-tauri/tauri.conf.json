{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any Music",
  "version": "0.1.0",
  "identifier": "com.anymusic.native",
  "build": {
    "beforeDevCommand": "pnpm dev:frontend",
    "devUrl": "http://127.0.0.1:21420",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Any Music",
        "width": 1280,
        "height": 850,
        "minWidth": 380,
        "minHeight": 600
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["amplugin"],
        "name": "Any Music Plugin",
        "description": "Any Music plugin installation preview",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["anymusic"]
      }
    }
  }
}
