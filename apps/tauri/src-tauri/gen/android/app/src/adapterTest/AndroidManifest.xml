<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Native adapter tests have no product launcher, native runtime or network. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <queries>
        <provider android:authorities="${applicationId}.test.documents" />
    </queries>
    <application android:label="Any Music Adapter Tests" tools:replace="android:label">
        <activity android:name="com.anymusic.app.BootstrapActivity" tools:node="remove" />
        <activity android:name="com.anymusic.app.MainActivity" tools:node="remove" />
        <provider android:name="androidx.core.content.FileProvider" tools:node="remove" />
    </application>
</manifest>
