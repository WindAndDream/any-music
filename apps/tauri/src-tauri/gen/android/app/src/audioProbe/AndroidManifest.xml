<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <application android:label="Any Music Audio Probe" tools:replace="android:label">
        <activity android:name="com.anymusic.app.BootstrapActivity" tools:node="remove" />
        <activity android:name="com.anymusic.app.MainActivity" tools:node="remove" />
        <provider android:name="androidx.core.content.FileProvider" tools:node="remove" />
        <receiver android:name="com.anymusic.app.AudioFocusProbeReceiver" android:exported="true" />
    </application>
</manifest>
